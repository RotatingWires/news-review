[Unit]
Description=NewsReview
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Replace these paths and account before installation. Build first with:
#   dotnet publish -c Release -o /opt/newsreview
User=newsreview
WorkingDirectory=/opt/newsreview
EnvironmentFile=-/etc/newsreview.env
ExecStart=/usr/bin/dotnet /opt/newsreview/NewsReview.dll --urls http://127.0.0.1:8714 --data-dir /var/lib/newsreview
Restart=on-failure
RestartSec=5
UMask=0077
# Encrypts the sign-in keys in data/keys with a secret only this service gets (src/SignInKeys.cs). Create it once:
#   head -c 32 /dev/urandom | sudo systemd-creds encrypt --name=newsreview-sign-in-keys - /etc/credstore.encrypted/newsreview-sign-in-keys
# Without it the service still starts; the keys are then owner-only files, unencrypted. Needs systemd 254 or later.
ImportCredential=newsreview-sign-in-keys
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Create /opt/newsreview/logs and make it writable by the service account.
ReadWritePaths=/var/lib/newsreview /opt/newsreview/logs

[Install]
WantedBy=multi-user.target
