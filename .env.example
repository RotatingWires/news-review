# Examples only. The app reads process environment variables, not this file.
# Keep the real values outside Git and load them through your shell/service.

# Required for LAN/non-loopback serving; minimum 12 characters.
NEWSREVIEW_PASSWORD=replace-with-a-long-private-password

# Optional; default is ./data relative to the working directory.
# NEWSREVIEW_DATA_DIR=/var/lib/newsreview

# Set to 1 when serving through HTTPS; cookies will require HTTPS.
# NEWSREVIEW_SECURE_COOKIE=1

# Optional authentication for a compatible local model server.
# NEWSREVIEW_MODEL_API_KEY=your-local-server-token
