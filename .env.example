# Examples only. The app reads process environment variables, not this file.
# Keep the real values outside Git and load them through your shell/service.

# Optional; default is ./data under the app's content root (the folder you start it from).
# NEWSREVIEW_DATA_DIR=/var/lib/newsreview

# Optional listening address; --urls on the command line does the same. Default: http://127.0.0.1:8714
# ASPNETCORE_URLS=http://0.0.0.0:8714

# Optional fallback for OpenRouter or compatible servers without a saved key.
# Normally save provider/server API keys in Settings -> AI instead.
# NEWSREVIEW_MODEL_API_KEY=your-model-server-key
